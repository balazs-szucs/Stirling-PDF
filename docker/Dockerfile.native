# =============================================================================
# Dockerfile.native - GraalVM Native Image build for Stirling-PDF
# =============================================================================
# Multi-stage build:
#   Stage 1: Build React frontend
#   Stage 2: Build native binary with GraalVM
#   Stage 3: Runtime image with native binary + system deps
#
# Usage:
#   docker build -f docker/Dockerfile.native -t stirling-pdf-native .
#   docker run -p 8080:8080 stirling-pdf-native
# =============================================================================

# Stage 1: Build Frontend
FROM node:20-alpine AS frontend-build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend .
RUN DISABLE_ADDITIONAL_FEATURES=false VITE_API_BASE_URL=/ npm run build

# Stage 2: Build Native Image with GraalVM
FROM ghcr.io/graalvm/graalvm-community:25 AS native-build

RUN native-image --version

# Install strip (binutils) for post-build binary stripping
RUN microdnf install -y binutils && microdnf clean all

WORKDIR /app

# Copy Gradle wrapper and build files first (for layer caching)
COPY gradlew .
COPY gradle gradle/
COPY build.gradle .
COPY settings.gradle .
COPY gradle.properties .
COPY app/core/build.gradle app/core/build.gradle
COPY app/common/build.gradle app/common/build.gradle
COPY app/proprietary/build.gradle app/proprietary/build.gradle

RUN mkdir -p app/core/src app/common/src app/proprietary/src

# Download dependencies (separate layer for caching)
RUN ./gradlew dependencies --no-daemon -PnoSpotless || true

# Copy full source code
COPY . .

# Copy pre-built frontend
COPY --from=frontend-build /app/dist/. frontend/dist/

# Verify frontend files are present
RUN echo "=== Verifying frontend files ===" && \
    test -f "frontend/dist/index.html" || { echo "ERROR: index.html missing!" && exit 1; } && \
    echo "✓ Frontend verified ($(find frontend/dist -type f | wc -l) files)"

# Build the native image
RUN DISABLE_ADDITIONAL_FEATURES=false \
    ./gradlew :stirling-pdf:nativeCompile \
    -PbuildWithFrontend=true \
    -Pnative.profile=production \
    -PnoSpotless \
    -x test \
    -x npmInstall \
    -x npmBuild \
    -x spotlessCheck \
    -x sonarqube \
    --no-daemon

# Verify the binary
RUN ls -la app/core/build/native/nativeCompile/ && \
    file app/core/build/native/nativeCompile/stirling-pdf

# Collect ONLY the companion .so files produced by native-image.
# GraalVM resolves these relative to the binary they MUST live alongside it.
# Also strip the binary and libs to save space.
RUN strip --strip-unneeded app/core/build/native/nativeCompile/stirling-pdf && \
    mkdir -p /native-libs && \
    cp app/core/build/native/nativeCompile/*.so /native-libs/ && \
    strip --strip-unneeded /native-libs/*.so 2>/dev/null || true && \
    echo "Collected $(ls /native-libs/*.so | wc -l) companion libraries" && \
    ls -la /native-libs/


# ==========================================================================
# Stage 3: Runtime image
# ==========================================================================
FROM debian:bookworm-slim

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

ARG VERSION_TAG

LABEL org.opencontainers.image.title="Stirling-PDF Native" \
      org.opencontainers.image.description="GraalVM Native Image build of Stirling-PDF" \
      org.opencontainers.image.source="https://github.com/Stirling-Tools/Stirling-PDF" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="Stirling-Tools" \
      org.opencontainers.image.url="https://www.stirlingpdf.com" \
      org.opencontainers.image.documentation="https://docs.stirlingpdf.com" \
      maintainer="Stirling-Tools" \
      org.opencontainers.image.authors="Stirling-Tools" \
      org.opencontainers.image.version="${VERSION_TAG}" \
      org.opencontainers.image.keywords="PDF, native, GraalVM, Spring Boot, React"

# ---------------------------------------------------------------------------
# Install ALL runtime deps, Calibre, LibreOffice in ONE layer.
# Strip bloat and clean up in the SAME layer so deleted bytes never persist.
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Core
    ca-certificates tzdata tini bash fontconfig curl gosu coreutils \
    # PDF tools
    ffmpeg poppler-utils ocrmypdf imagemagick fontforge ghostscript unpaper qpdf \
    # Python + UNO bridge
    python3 python3-venv python3-uno \
    # OCR
    tesseract-ocr tesseract-ocr-eng tesseract-ocr-deu tesseract-ocr-fra \
    tesseract-ocr-por tesseract-ocr-chi-sim tesseract-ocr-spa \
    # Fonts (same set as embedded Dockerfile)
    fonts-dejavu fonts-liberation2 \
    fonts-crosextra-caladea fonts-crosextra-carlito \
    fonts-linuxlibertine \
    fonts-noto-core fonts-noto-cjk fonts-noto-mono \
    # Graphics / AWT headless (native binary needs these for PDF rendering)
    libcairo2 libpango-1.0-0 libpangoft2-1.0-0 libgdk-pixbuf-2.0-0 \
    libfreetype6 libfontconfig1 libx11-6 libxt6 libxext6 libxrender1 libxtst6 libxi6 \
    libxinerama1 libxkbcommon0 libxkbfile1 libsm6 libice6 \
    # Qt WebEngine deps (Calibre ebook-convert EPUB→PDF)
    libegl1 libopengl0 libgl1 libxdamage1 libxfixes3 libxshmfence1 libdrm2 libgbm1 \
    libxkbcommon-x11-0 libxrandr2 libxcomposite1 libnss3 libx11-xcb1 \
    libxcb-cursor0 libdbus-1-3 libglib2.0-0 \
    # Headless display (required by Calibre Qt WebEngine)
    xvfb \
    # LibreOffice headless (-nogui uses svp VCL plugin, no X11/display needed)
    libreoffice-writer-nogui libreoffice-calc-nogui \
    libreoffice-impress-nogui libreoffice-draw-nogui \
    # Temp: only for Calibre installer
    xz-utils gpgv xdg-utils \
    # Health check utility for unoserver watchdog
    netcat-openbsd \
    \
    # ---- Calibre ----
    # ---- Calibre (Manual Install) ----
    && curl -fsSL -o /tmp/calibre.txz https://download.calibre-ebook.com/9.2.1/calibre-9.2.1-x86_64.txz \
    && mkdir -p /opt/calibre \
    && tar -xJC /opt/calibre -f /tmp/calibre.txz \
    && rm /tmp/calibre.txz \
    && ln -sf /opt/calibre/ebook-convert /usr/bin/ebook-convert \
    \
    # ---- Calibre Stripping ----
    # Keep: ebook-convert, calibre-parallel, calibre-debug, Qt WebEngine (EPUB→PDF)
    # Removed aggressive stripping of root files to fix "missing modules" errors
    # (Original find command removed here)
    && rm -rf /opt/calibre/calibre-server \
              /opt/calibre/calibre-smtp \
              /opt/calibre/calibredb \
              /opt/calibre/calibre \
              /opt/calibre/lrf* \
              /opt/calibre/markdown-calibre \
              /opt/calibre/web2disk \
              /opt/calibre/fetch-ebook-metadata \
              /opt/calibre/ebook-edit \
              /opt/calibre/ebook-viewer \
              /opt/calibre/ebook-polish \
              /opt/calibre/ebook-meta \
              /opt/calibre/ebook-device \
              /opt/calibre/lib/calibre/gui2 \
              /opt/calibre/lib/calibre/devices \
              /opt/calibre/lib/calibre/library \
              /opt/calibre/lib/calibre/db \
              /opt/calibre/lib/calibre/srv \
              /opt/calibre/lib/libQt5Multimedia* \
              /opt/calibre/lib/libQt53D* \
              /opt/calibre/translations \
              /opt/calibre/plugins/Viewer \
              /opt/calibre/history.plist \
              /opt/calibre/app_icon.png \
    && find /opt/calibre -type f -name '*.py[co]' -delete \
    && find /opt/calibre -name '__pycache__' -type d -exec rm -rf {} + 2>/dev/null || true \
    \
    # ---- Strip LibreOffice ----
    && rm -rf /usr/share/libreoffice/help \
              /usr/share/libreoffice/share/gallery \
              /usr/share/libreoffice/share/config/soffice.cfg/simpress \
              /usr/share/libreoffice/share/config/soffice.cfg/modules/simpress \
              /usr/lib/libreoffice/share/gallery \
              /usr/lib/libreoffice/readmes \
              /usr/lib/libreoffice/share/autotext \
              /usr/lib/libreoffice/share/extensions/wiki-publisher \
              /usr/lib/libreoffice/share/extensions/nlpsolver \
    \
    # ---- Global Cleanup (Docs, Man, Locales) ----
    && rm -rf /usr/share/doc \
              /usr/share/man \
              /usr/share/info \
              /usr/share/lintian \
              /usr/share/linda \
              /usr/share/bug \
              /usr/share/pixmaps \
              /usr/share/applications \
    # Remove all locales except English (libc)
    && find /usr/share/locale -mindepth 1 -maxdepth 1 \
         ! -name 'en' ! -name 'en_US' ! -name 'locale.alias' \
         -exec rm -rf {} + 2>/dev/null || true \
    && find /usr/share/i18n/locales -mindepth 1 \
         ! -name 'en_US' ! -name 'en_GB' ! -name 'POSIX' ! -name 'i18n*' ! -name 'iso*' ! -name 'translit*' \
         -exec rm -f {} + 2>/dev/null || true \
    \
    # ---- Clean up ----
    && apt-get purge -y xz-utils xdg-utils gpgv \
    && apt-get autoremove -y --purge \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /var/log/*.log /var/log/apt \
    \
    # Backup tessdata for entrypoint
    && mkdir -p /usr/share/tessdata-original \
    && cp -r /usr/share/tesseract-ocr/5/tessdata/* /usr/share/tessdata-original/ 2>/dev/null || true

# ==============================================================================
# Create non-root user
# ==============================================================================
ARG PUID=1000
ARG PGID=1000

RUN set -eux; \
    if ! getent group stirlingpdfgroup >/dev/null 2>&1; then \
    if getent group "${PGID}" >/dev/null 2>&1; then \
    groupadd -o -g "${PGID}" stirlingpdfgroup; \
    else \
    groupadd -g "${PGID}" stirlingpdfgroup; \
    fi; \
    fi; \
    if ! id -u stirlingpdfuser >/dev/null 2>&1; then \
    if getent passwd | awk -F: -v id="${PUID}" '$3==id{found=1} END{exit !found}'; then \
    echo "UID ${PUID} already in use – creating stirlingpdfuser with automatic UID"; \
    useradd -m -g stirlingpdfgroup -d /home/stirlingpdfuser -s /bin/bash stirlingpdfuser; \
    else \
    useradd -m -u "${PUID}" -g stirlingpdfgroup -d /home/stirlingpdfuser -s /bin/bash stirlingpdfuser; \
    fi; \
    fi

RUN ln -sf /usr/sbin/gosu /usr/local/bin/su-exec

# ==============================================================================
# Copy native binary + companion .so files
# --chown on COPY sets ownership WITHOUT creating a duplicate layer.
# NEVER chown -R /app later — that would duplicate the entire 480 MB binary.
# ==============================================================================
COPY --from=native-build --chown=stirlingpdfuser:stirlingpdfgroup \
    /app/app/core/build/native/nativeCompile/stirling-pdf /app/stirling-pdf
COPY --from=native-build --chown=stirlingpdfuser:stirlingpdfgroup \
    /native-libs/*.so /app/

# Copy scripts, fonts, entrypoint — set ownership via --chown to avoid later chown
COPY --chown=stirlingpdfuser:stirlingpdfgroup scripts /scripts
COPY app/core/src/main/resources/static/fonts/*.ttf /usr/share/fonts/opentype/noto/
COPY --chmod=755 docker/native/entrypoint.sh /entrypoint.sh

# ==============================================================================
# Runtime environment
# ==============================================================================
ENV VERSION_TAG=$VERSION_TAG \
    HOME=/home/stirlingpdfuser \
    PUID=${PUID} \
    PGID=${PGID} \
    UMASK=022 \
    PYTHONPATH=/usr/lib/libreoffice/program \
    UNO_PATH=/usr/lib/libreoffice/program \
    LIBREOFFICE_BIN_PATH=/usr/lib/libreoffice/program/soffice.bin \
    URE_BOOTSTRAP=file:///usr/lib/libreoffice/program/fundamentalrc \
    SAL_USE_VCLPLUGIN=svp \
    STIRLING_TEMPFILES_DIRECTORY=/tmp/stirling-pdf \
    TMPDIR=/tmp/stirling-pdf \
    TEMP=/tmp/stirling-pdf \
    TMP=/tmp/stirling-pdf

# ==============================================================================
# Python venvs + unoserver — single layer
# ==============================================================================
ARG UNOSERVER_VERSION=3.6
RUN python3 -m venv /opt/venv --system-site-packages \
    && /opt/venv/bin/pip install --no-cache-dir \
        weasyprint pdf2image opencv-python-headless \
    && python3 -m venv /opt/unoserver-venv --system-site-packages \
    && /opt/unoserver-venv/bin/pip install --no-cache-dir "unoserver==${UNOSERVER_VERSION}" \
    && ln -sf /opt/unoserver-venv/bin/unoconvert /opt/venv/bin/unoconvert \
    && ln -sf /opt/unoserver-venv/bin/unoserver  /opt/venv/bin/unoserver \
    # ---- Clean up Python venvs ----
    && find /opt/venv /opt/unoserver-venv -type f -name '*.so' \
         -exec strip --strip-unneeded {} + 2>/dev/null || true \
    && find /opt/venv -type f -name '*.pyc' -delete \
    && find /opt/venv -type d -name '__pycache__' -exec rm -rf {} + \
    && find /opt/unoserver-venv -type f -name '*.pyc' -delete \
    && find /opt/unoserver-venv -type d -name '__pycache__' -exec rm -rf {} +

ENV PATH="/opt/venv/bin:/opt/unoserver-venv/bin:${PATH}"

RUN set -eux; \
    chmod +x /scripts/* 2>/dev/null || true; \
    chmod +x /app/stirling-pdf; \
    mkdir -p /configs /configs/heap_dumps /logs /customFiles \
             /pipeline/watchedFolders /pipeline/finishedFolders /tmp/stirling-pdf \
             /home/stirlingpdfuser/.config/libreoffice/4/user; \
    chown -R stirlingpdfuser:stirlingpdfgroup \
        /home/stirlingpdfuser /configs /logs /customFiles /pipeline /tmp/stirling-pdf \
        /usr/share/fonts/opentype/noto; \
    chmod -R 755 /tmp/stirling-pdf; \
    fc-cache -f

ENV QT_QPA_PLATFORM=offscreen \
    QTWEBENGINE_CHROMIUM_FLAGS="--no-sandbox --disable-gpu --disable-dev-shm-usage --disable-software-rasterizer" \
    QTWEBENGINE_DISABLE_SANDBOX=1 \
    DISPLAY=:99

EXPOSE 8080/tcp
STOPSIGNAL SIGTERM
ENTRYPOINT ["tini", "--", "/entrypoint.sh"]
CMD []
