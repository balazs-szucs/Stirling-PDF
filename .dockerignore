# .dockerignore
.git
.github
.gradle
.idea
*.iml

# Build outputs — MUST exclude or COPY . . brings stale binaries
**/build/
!gradle/wrapper/

# Frontend build output (built in Docker)
frontend/node_modules/
frontend/dist/

# Dev files
*.md
!docs/
LICENSE
docker-compose*.yml
.env*
.vscode/
.editorconfig
.gitattributes
